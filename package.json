{
  "name": "digitalsellers-extension",
  "version": "0.4.0",
  "description": "Chrome extension paraguas del ecosistema DigitalSellers. Inyecta un botón en MercadoLibre que dispara Analyzer, Simulador y futuras herramientas DS con un click.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "pack": "npm run build && node scripts/pack.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "author": "DigitalSellers (Seba Rodriguez)",
  "license": "UNLICENSED",
  "homepage": "https://analyzer.digitalsellers.com.ar",
  "dependencies": {
    "zod": "^3.23.8"
  },
  "overrides": {
    "@crxjs/vite-plugin": {
      "rollup": "2.80.0"
    }
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.1",
    "sharp": "^0.33.5",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  }
}
